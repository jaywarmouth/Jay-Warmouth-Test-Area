    <ReportParameter Name="GroupNumber">
      <DataType>String</DataType>
      <AllowBlank>true</AllowBlank>
      <Prompt>GroupNumber</Prompt>
    </ReportParameter>
  </ReportParameters>
  <Code>Function GetValue(parameter as Object) as String
   Dim s as String 
   Dim i as integer
   IF parameter.IsMultiValue THEN
      's = "Multivalue: " 
      For i = 0 to parameter.Count-1
         's = s &amp; RTrim(parameter.Value(i)) &amp; ": "
         s = s  &amp; RTrim(parameter.Label(i))
         IF i &lt; parameter.Count-1 THEN
            s = s &amp; ", "
         END IF 
      Next
   ELSE
      's = "Single value: " + CStr(parameter.Value)
      s  = RTrim(parameter.Value(i))
   END IF
   Return REPLACE(s,"","")
End Function</Code>
