      <Prompt>ReportID</Prompt>
    </ReportParameter>
    <ReportParameter Name="DateFlag">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>R</Value>
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>Date Flag</Prompt>
    </ReportParameter>
    <ReportParameter Name="BegDate">
      <DataType>Integer</DataType>
