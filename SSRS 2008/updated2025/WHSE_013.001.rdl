<?xml version='1.0' encoding='UTF-8'?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSources>
    <DataSource Name="claims">
      <DataSourceReference>claims</DataSourceReference>
      <rd:DataSourceID>cfc1fe7f-853c-4fe7-a77e-bee3f5c4e168</rd:DataSourceID>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ds_InvoiceCheck">
      <Fields>
        <Field Name="INL_SYSTEM_NBR">
          <DataField>INL_SYSTEM_NBR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="INL_SPONSOR_NBR">
          <DataField>INL_SPONSOR_NBR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="INL_GROUP_NBR">
          <DataField>INL_GROUP_NBR</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="INL_PERIOD_ENDING">
          <DataField>INL_PERIOD_ENDING</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="INL_SYS_CARD_INV">
          <DataField>INL_SYS_CARD_INV</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="INL_SPO_CARD_INV">
          <DataField>INL_SPO_CARD_INV</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="INL_GRP_CARD_INV">
          <DataField>INL_GRP_CARD_INV</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="whereMatch">
          <DataField>whereMatch</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ClaimAmount">
          <DataField>ClaimAmount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AdminAmount">
          <DataField>AdminAmount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalAmount">
          <DataField>TotalAmount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandText>SELECT 
    INL_SYSTEM_NBR,
    INL_SPONSOR_NBR,
    INL_GROUP_NBR,
    INL_PERIOD_ENDING,
    INL_SYS_CARD_INV,
    INL_SPO_CARD_INV,
    INL_GRP_CARD_INV,

    -- Claim Amount
    INL_CLAIM_INV_AMT AS ClaimAmount,

    -- Admin Amount (take whichever matches the invoice number)
    CASE 
        WHEN (INL_SYS_CLAIM_INV_NUM = '659522') THEN INL_SYS_ADMIN_FEE
        WHEN (INL_SPO_CLAIM_INV_NUM = '659522') THEN INL_SPO_ADMIN_FEE
        WHEN (INL_GRP_CLAIM_INV_NUM = '659522') THEN INL_GRP_ADMIN_FEE
    END AS AdminAmount,

    -- Total = Claim + Admin
    (INL_CLAIM_INV_AMT +
        CASE 
            WHEN (INL_SYS_CLAIM_INV_NUM = '659522') THEN INL_SYS_ADMIN_FEE
            WHEN (INL_SPO_CLAIM_INV_NUM = '659522') THEN INL_SPO_ADMIN_FEE
            WHEN (INL_GRP_CLAIM_INV_NUM = '659522') THEN INL_GRP_ADMIN_FEE
            ELSE 0
        END
    ) AS TotalAmount,

    -- Where matched type
    CASE 
        WHEN (INL_SYS_CLAIM_INV_NUM = '659522') THEN 'SYSTEM'
        WHEN (INL_SPO_CLAIM_INV_NUM = '659522') THEN 'SPONSOR'
        WHEN (INL_GRP_CLAIM_INV_NUM = '659522') THEN 'MASTER_GROUP'
        WHEN (INL_SYS_CARD_INV = '659522') THEN 'SYSTEM CARD'
        WHEN (INL_SPO_CARD_INV = '659522') THEN 'SPONSOR CARD'
        WHEN (INL_GRP_CARD_INV = '659522') THEN 'MASTER_GROUP CARD'
    END as whereMatch

FROM INLOG 
WHERE (
    (INL_SYS_CLAIM_INV_NUM = '659522')
    OR (INL_SPO_CLAIM_INV_NUM = '659522')
    OR (INL_GRP_CLAIM_INV_NUM = '659522')
    OR (INL_SYS_CARD_INV = '659522')
    OR (INL_SPO_CARD_INV = '659522')
    OR (INL_GRP_CARD_INV = '659522')
);</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
