  <Code>Function GetValue(ByVal parameterName As String) As String
   Dim s as String  =  " "  &amp; vbCrLf   
   Dim i as Integer
   IF Report.Parameters(parameterName).Label(0) = " All" THEN
     s = s &amp;  Report.Parameters(parameterName).Label(0)
     s = s &amp; vbCrLf &amp; vbCrLf
     return s
   ELSE
    For i = 0 to Report.Parameters(parameterName).Count - 1
       s = s  &amp; RTrim(Report.Parameters(parameterName).Label(i))
       IF i &lt; Report.Parameters(parameterName).Count -1 THEN
           s = s &amp; ", "
       END IF

       IF (i  Mod 3) = 2 THEN
           s = s &amp; " "  &amp; vbCrLf  
       ELSE 
           s = s &amp; " "
       END IF 

       IF i = Report.Parameters(parameterName).Count -1 AND  (i  Mod 3) &lt;&gt; 2 THEN
           s = s &amp; vbCrLf
       END IF
       IF i = Report.Parameters(parameterName).Count -1 THEN
           s = s &amp; vbCrLf
       END IF
   Next
   END IF
   Return s
End Function

Function isMultipleSelectionReport() As boolean
  Dim isMultipleSelection As boolean = false
  IF Report.Parameters("SystemLink").Count &gt; 1 THEN
    return true
  ELSE IF Report.Parameters("SystemNumber").Count &gt; 1 THEN
    return true
  ELSE IF Report.Parameters("SponsorNumber").Count &gt; 1 THEN
    return true
  ELSE IF Report.Parameters("MasterGroupNumber").Count &gt; 1 THEN
    return true
  ELSE IF Report.Parameters("GroupNumber").Count &gt; 1 THEN
    return true
  END IF
  return false
End Function

       'IF i &lt; Report.Parameters(parameterName).Count Mod 2 = 1 THEN
       '    s = s &amp; " "  &amp; vbCrLf  
       'ELSE 
       '    s = s &amp; " "
       'END IF
</Code>
