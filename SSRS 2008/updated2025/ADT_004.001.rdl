    <DataSet Name="ds_Overrides_Exceptions">
      <Fields>
        <Field Name="OV_GPI">
          <DataField>OV_GPI</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GPI_DESCRIPTION">
          <DataField>GPI_DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_CARDHOLDER_NUMBER">
          <DataField>OV_CARDHOLDER_NUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_MEMBER_NUMBER">
          <DataField>OV_MEMBER_NUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_TYPE_CODE">
          <DataField>OV_TYPE_CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OV_EFFECTIVE_DATE">
          <DataField>OV_EFFECTIVE_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OV_REASON">
          <DataField>OV_REASON</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_TYPE_CODE_2">
          <DataField>OV_TYPE_CODE_2</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OV_EFFECTIVE_DATE_2">
          <DataField>OV_EFFECTIVE_DATE_2</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OV_REASON_2">
          <DataField>OV_REASON_2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandText>SELECT 
	o1.OV_GPI,
	GPI_DATA.GPI_DESCRIPTION,
	o1.OV_CARDHOLDER_NUMBER,
	o1.OV_MEMBER_NUMBER,
	o1.OV_TYPE_CODE,
	o1.OV_EFFECTIVE_DATE,
	o1.OV_REASON,
	o2.EX_TYPE_CODE as OV_TYPE_CODE_2,
	o2.EX_EFF_DATE_1 as OV_EFFECTIVE_DATE_2,
	o2.EX_REASON as OV_REASON_2
	
FROM 
	OVERRIDES o1
	INNER JOIN Exceptions o2
                                ON  SUBSTRING(o1.OV_GPI,1,10) + '0000' = o2.EX_GPI
		AND o1.OV_MEMBER_NUMBER = o2.EX_MEMBER_NUMBER
		AND o1.OV_CARDHOLDER_NUMBER = o2.EX_CARDHOLDER_NUMBER
	INNER JOIN GPI_DATA
		ON GPI_DATA.GPI = o1.OV_GPI 
WHERE 
		o1.OV_TYPE_CODE = '30'
	AND o1.OV_EFFECTIVE_DATE BETWEEN @BegDate1 AND @EndDate1
	AND o1.OV_SPONSOR = @SponsorNumber
	AND o2.EX_TYPE_CODE &lt;&gt; '30'
	AND o2.EX_EFF_DATE_1 BETWEEN @BegDate1 AND @EndDate1
	AND o2.EX_SPONSOR = @SponsorNumber
ORDER BY 
	o1.OV_EFFECTIVE_DATE,
	o2.EX_EFF_DATE_1</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BegDate1">
            <Value>=Parameters!BegDate1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate1">
            <Value>=Parameters!EndDate1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SponsorNumber">
            <Value>=Parameters!SponsorNumber.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
