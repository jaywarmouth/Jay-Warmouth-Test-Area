<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>Exception Level Dose Check Audit</Description>
  <DataSources>
    <DataSource Name="claims">
      <DataSourceReference>claims</DataSourceReference>
      <rd:DataSourceID>fc05f385-358c-4993-b5be-7f4fd7850ace</rd:DataSourceID>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ds_Overrides_Overrides">
      <Fields>
        <Field Name="OV_GPI">
          <DataField>OV_GPI</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GPI_DESCRIPTION">
          <DataField>GPI_DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_CARDHOLDER_NUMBER">
          <DataField>OV_CARDHOLDER_NUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_MEMBER_NUMBER">
          <DataField>OV_MEMBER_NUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_TYPE_CODE">
          <DataField>OV_TYPE_CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OV_EFFECTIVE_DATE">
          <DataField>OV_EFFECTIVE_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OV_REASON">
          <DataField>OV_REASON</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OV_TYPE_CODE_2">
          <DataField>OV_TYPE_CODE_2</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OV_EFFECTIVE_DATE_2">
          <DataField>OV_EFFECTIVE_DATE_2</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OV_REASON_2">
          <DataField>OV_REASON_2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandText>SELECT     o1.OV_GPI, dbo.GPI_DATA.GPI_DESCRIPTION, o1.OV_CARDHOLDER_NUMBER, o1.OV_MEMBER_NUMBER, o1.OV_TYPE_CODE, 
                      o1.OV_EFFECTIVE_DATE, o1.OV_REASON, o2.OV_TYPE_CODE AS OV_TYPE_CODE_2, o2.OV_EFFECTIVE_DATE AS OV_EFFECTIVE_DATE_2, 
                      o2.OV_REASON AS OV_REASON_2
FROM         dbo.OVERRIDES AS o1 INNER JOIN
                      dbo.OVERRIDES AS o2 ON o1.OV_GPI = o2.OV_GPI AND o1.OV_MEMBER_NUMBER = o2.OV_MEMBER_NUMBER AND 
                      o1.OV_CARDHOLDER_NUMBER = o2.OV_CARDHOLDER_NUMBER INNER JOIN
                      dbo.GPI_DATA ON dbo.GPI_DATA.GPI = o1.OV_GPI
WHERE     (o1.OV_TYPE_CODE = '30') AND (o1.OV_EFFECTIVE_DATE BETWEEN @BegDate1 AND @EndDate1) AND (o1.OV_SPONSOR = @SponsorNumber) AND 
                      (o2.OV_TYPE_CODE &lt;&gt; '30') AND (o2.OV_EFFECTIVE_DATE BETWEEN @BegDate1 AND @EndDate1) AND (o2.OV_SPONSOR = @SponsorNumber)
ORDER BY o1.OV_EFFECTIVE_DATE, OV_EFFECTIVE_DATE_2</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BegDate1">
            <Value>=Parameters!BegDate1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate1">
            <Value>=Parameters!EndDate1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SponsorNumber">
            <Value>=Parameters!SponsorNumber.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
    </DataSet>
    <DataSet Name="ds_UserName">
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandText>SELECT DISTINCT SUBSTRING(DC_USER,1,LEN(DC_USER)-2) FROM AUDIT.dbo.DOSE ORDER BY  SUBSTRING(DC_USER,1,LEN(DC_USER)-2)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
