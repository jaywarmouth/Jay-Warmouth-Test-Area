                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=iif((Fields!ClaimsIndicator.Value = "R") or (Fields!ClaimsIndicator.Value = "N" and Fields!RejectCode.Value = 601 and Fields!AmtPaid.Value &lt; 0), "Reversal" , "")</Value>
