      <Query>
        <DataSourceName>claims_subscriptions</DataSourceName>
        <CommandText>SELECT PHARM_NETWORK.NETWORK_NUMBER,
       PHDEM.NABP_7,
       PHARM_NETWORK.NABP_NUMBER,
       PHDEM.NPI_NUMBER,
       PHARM_NETWORK.STATE_CODE,
       PHDEM.PHARMACY_NAME,
       PHARM_NETWORK.EFF_DATE_1,
       PHARM_NETWORK.TERM_DATE_1,
       PHDEM.STREET_1,
       PHDEM.STREET_2,
       PHDEM.CITY,
       PHDEM.STATE,
       PHDEM.ZIP,
       PHDEM.PHONE,
       PHARM_NETWORK.PDM_CHAIN_NUMBER_1
FROM Claims.dbo.PHARM_NETWORK with (NoLock) 
     INNER JOIN Claims.dbo.PHDEM  with (NoLock)
        ON (PHARM_NETWORK.NABP_NUMBER = PHDEM.NABP_NUMBER)
WHERE (PHARM_NETWORK.NETWORK_NUMBER = 3310)</CommandText>
