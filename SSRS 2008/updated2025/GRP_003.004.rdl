                                                  <FontSize>7pt</FontSize>
                                                  <Format>##0.0%</Format>
                                                </Style>
                                              </TextRun>
                                            </TextRuns>
                                            <Style>
                                              <TextAlign>Right</TextAlign>
                                            </Style>
