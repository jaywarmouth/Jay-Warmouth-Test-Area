                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF((Sum(Fields!AmtPaid.Value)+Sum(Fields!Copay.Value))&lt;&gt;0 And Sum(Fields!Claims.Value)&lt;&gt;0,(Sum(Fields!AmtPaid.Value)+Sum(Fields!Copay.Value))/Sum(Fields!Claims.Value),0)</Value>
