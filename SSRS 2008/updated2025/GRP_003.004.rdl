                                    </CellContents>
                                  </TablixCell>
                                  <TablixCell>
                                    <CellContents>
                                      <Textbox Name="textbox111">
                                        <CanGrow>true</CanGrow>
                                        <KeepTogether>true</KeepTogether>
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=IIF(Sum(Fields!Members.Value)&lt;&gt;0 And FIRST(Fields!Month.Value)&lt;&gt;0,Sum(Fields!Members.Value)/FIRST(Fields!Month.Value),0)</Value>
                                                <Style>
                                                  <FontSize>7pt</FontSize>
                                                  <Format>##,###,##0</Format>
                                                </Style>
                                              </TextRun>
                                            </TextRuns>
                                            <Style>
