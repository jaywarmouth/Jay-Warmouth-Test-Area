                                                          <TextRuns>
                                                            <TextRun>
                                                            <Value>=IIF(Sum(Fields!NonFormularyClaims.Value)&lt;&gt;0 And Sum(Fields!Claims.Value)&lt;&gt;0,Sum(Fields!NonFormularyClaims.Value)/Sum(Fields!Claims.Value),0)</Value>
