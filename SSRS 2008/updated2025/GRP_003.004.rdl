                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TotalPaid_1">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>= Sum(Fields!AmtPaid.Value) +  Sum(Fields!Copay.Value)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>c0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
