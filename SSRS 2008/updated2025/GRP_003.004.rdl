                                  <TablixCell>
                                    <CellContents>
                                      <Textbox Name="textbox114">
                                        <CanGrow>true</CanGrow>
                                        <KeepTogether>true</KeepTogether>
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=Sum(Fields!ActiveMembers.Value)</Value>
                                                <Style>
                                                  <FontSize>7pt</FontSize>
                                                  <Format>##,###,##0</Format>
                                                </Style>
                                              </TextRun>
