      <Query>
        <DataSourceName>claims_subscriptions</DataSourceName>
        <CommandText>SELECT DISTINCT
GROUP_DATA.GROUP_TER_DATE,GROUP_DATA.PLAN_EFF_DATE_1,PLAN_DATA.*

FROM PLAN_DATA
INNER JOIN GROUP_DATA
ON GROUP_DATA.PLAN_KEY = PLAN_DATA.PLAN_KEY 
INNER JOIN Sponsor
ON Sponsor.SponsorNumber = GROUP_DATA.SPONSOR_NUMBER

WHERE
(GROUP_DATA.GROUP_TER_DATE IS NULL OR GROUP_TER_DATE &gt;= GETDATE())
AND GROUP_DATA.PLAN_EFF_DATE_1 &lt;=GETDATE()
AND GROUP_DATA.PURGE_STATUS = 0
AND RXEOBFlag = 'Y'
AND PLAN_DATA.PLAN_NUMBER IS NOT NULL</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
