            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <KeepTogether>true</KeepTogether>
                </TablixMember>
                <TablixMember>
                  <Group Name="OCC8">
                    <Filters>
                      <Filter>
                        <FilterExpression>=Fields!OTHER_COVERAGE_CODE.Value</FilterExpression>
                        <Operator>Equal</Operator>
                        <FilterValues>
                          <FilterValue DataType="Integer">8</FilterValue>
                        </FilterValues>
                      </Filter>
                      <Filter>
                        <FilterExpression>=IIF((Fields!GROUP_NUMBER.Value &gt;= "75535001"
    AND Fields!GROUP_NUMBER.Value &lt;= "75535003" 
    AND Fields!COPAY.Value &gt; 0), 1, 0)</FilterExpression>
                        <Operator>Equal</Operator>
                        <FilterValues>
                          <FilterValue DataType="Integer">1</FilterValue>
                        </FilterValues>
                      </Filter>
                      <Filter>
                        <FilterExpression>=IIF((Fields!GROUP_NUMBER.Value = "75535001" 
