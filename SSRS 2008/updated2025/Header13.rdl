                    <TextRuns>
                      <TextRun>
                        <Value>="Year Month " &amp; rtrim( Parameters!BegDate.Value ) &amp; "  thru  " &amp; "Year Month " &amp;  rtrim( Parameters!EndDate.Value )</Value>
