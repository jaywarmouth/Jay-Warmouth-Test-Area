      <rd:DataSourceID>fd1b6447-ea3a-489f-bbf8-e619f93a316e</rd:DataSourceID>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsSystemLInkInfo">
      <Fields>
        <Field Name="SYSTEM_LINK">
          <DataField>SYSTEM_LINK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SYS_LINK_DESCRIPTION">
          <DataField>SYS_LINK_DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LINK_RECORDS">
          <DataField>LINK_RECORDS</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>pr_SystemLinkInfo</CommandText>
        <QueryParameters>
          <QueryParameter Name="@SystemLink">
            <Value>=Parameters!SystemLink.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
    </DataSet>
    <DataSet Name="dsReports">
      <Fields>
        <Field Name="Rpt_ID_pk">
          <DataField>Rpt_ID_pk</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RptDesc">
          <DataField>RptDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RptTitle">
          <DataField>RptTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandText>SELECT     Rpt_ID_pk, RptDesc, RptTitle
FROM         Reports
WHERE     (Rpt_ID_pk = @ReportID)</CommandText>
        <QueryParameters>
          <QueryParameter Name="@ReportID">
            <Value>=Parameters!ReportID.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
    </DataSet>
    <DataSet Name="dsServername">
      <Fields>
        <Field Name="ID">
          <DataField/>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>claims</DataSourceName>
        <CommandText>select substring(@@servername, 1, 1)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="ReportID">
      <DataType>String</DataType>
      <Prompt>ReportID</Prompt>
    </ReportParameter>
    <ReportParameter Name="BegDate">
      <DataType>Integer</DataType>
      <AllowBlank>true</AllowBlank>
      <Prompt>Beg Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>Integer</DataType>
      <AllowBlank>true</AllowBlank>
      <Prompt>End Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="SystemLink">
      <DataType>String</DataType>
      <Prompt>SystemLink</Prompt>
    </ReportParameter>
  </ReportParameters>
