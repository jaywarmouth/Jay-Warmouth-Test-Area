            <DataSetName>pr_QTR_PKG_CHART_001_002b</DataSetName>
            <Top>0.80556in</Top>
            <Left>5.23845in</Left>
            <Height>1.86875in</Height>
            <Width>4.83708in</Width>
            <ZIndex>1</ZIndex>
            <Style>
