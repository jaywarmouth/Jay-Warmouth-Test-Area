                    <TablixCell>
                      <CellContents>
                        <Textbox Name="PrevGrossPMPM">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=((sum(Fields!PrevAmtPaid.Value) + sum(Fields!PrevCopay.Value)) / Fields!PrevMembers.Value)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
