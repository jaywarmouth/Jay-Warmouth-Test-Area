                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Copay4">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!AmtPaid.Value + Fields!Copay.Value) / Fields!DaysSupply.Value</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Format>c2</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
