      </Query>
    </DataSet>
    <DataSet Name="LisWhseAGClaims_CLAIM55DATA_Discrepancies">
      <Fields>
        <Field Name="SYSTEM_NUMBER">
          <DataField>SYSTEM_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SPONSOR_NUMBER">
          <DataField>SPONSOR_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MASTER_GROUP">
          <DataField>MASTER_GROUP</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="GROUP_NUMBER">
          <DataField>GROUP_NUMBER</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="YEAR_MONTH">
          <DataField>YEAR_MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WAREHOUSENAME">
          <DataField>WAREHOUSENAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CLAIM55CLAIMCOUNT">
          <DataField>CLAIM55CLAIMCOUNT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CLAIM55AMOUNTPAID">
          <DataField>CLAIM55AMOUNTPAID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CLAIMSCLAIMCOUNT">
          <DataField>CLAIMSCLAIMCOUNT</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CLAIMSAMOUNTPAID">
          <DataField>CLAIMSAMOUNTPAID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="COUNTDIFF">
          <DataField>COUNTDIFF</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AMTDIFF">
          <DataField>AMTDIFF</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TOTALCLAIMCOUNT">
          <DataField>TOTALCLAIMCOUNT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TOTALAMTPAID">
          <DataField>TOTALAMTPAID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>LisWhseAGClaims</DataSourceName>
        <CommandText>select A.SYSTEM_NUMBER AS SYSTEM_NUMBER,
		A.SPONSOR_NUMBER AS SPONSOR_NUMBER,
		A.MASTER_GROUP AS MASTER_GROUP,
		A.GROUP_NUMBER AS GROUP_NUMBER,
	   A.YEAR_MONTH AS YEAR_MONTH,
	   A.WAREHOUSENAME AS WAREHOUSENAME,
	   ISNULL(A.CLAIM55CLAIMCOUNT,0) AS CLAIM55CLAIMCOUNT,
	   ISNULL(A.CLAIM55AMOUNTPAID,0) AS CLAIM55AMOUNTPAID,
	   ISNULL(B.ClaimsClaimCount,0) AS CLAIMSCLAIMCOUNT,
	   ISNULL(B.ClaimsAmountPaid,0) AS CLAIMSAMOUNTPAID,
	   ISNULL(A.CLAIM55CLAIMCOUNT,0) - ISNULL(B.CLAIMSCLAIMCOUNT,0) AS COUNTDIFF,
	   ISNULL(A.CLAIM55AMOUNTPAID,0) - ISNULL(B.CLAIMSAmOUNTPAID,0) AS AMTDIFF,
	   A.TOTALCLAIMCOUNT AS TOTALCLAIMCOUNT,
	   A.TOTALAMTPAID AS TOTALAMTPAID
FROM


(
select 

GROUP_DATA.SYSTEM_NUMBER,
Group_Data.SPONSOR_NUMBER,
Group_Data.MASTER_GROUP,
Group_Data.GROUP_NUMBER,
Claim55.YEAR_MONTH,
JOB_ACTIVITY_AUDIT.WarehouseName,
ISNULL(Sum(Claim55.CLAIMS),0) as Claim55ClaimCount,
ISNULL(Sum(Claim55.AMOUNT_PAID),0) as Claim55AmountPaid,

(
select ISNULL(Sum(Claim55.CLAIMS),0)
From JOB_ACTIVITY_AUDIT,CLAIM55,GROUP_DATA
              WHERE CLAIM55.GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date
					AND JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle
					AND CLAIM55.YEAR_MONTH = cast(cast(year(@Cycle_End_Date) as varchar(4)) + 
						case when len(cast(month(@Cycle_End_Date) as varchar(2))) &lt; 2 Then '0' + cast(month(@Cycle_End_Date) as varchar(2)) 
						else cast(month(@Cycle_End_Date) as varchar(2)) end as int)
						--AND GROUP_DATA.SYSTEM_NUMBER IN(@SYSTEM_NUMBER)
  ) as TotalClaimCount,

(
select ISNULL(Sum(Claim55.AMOUNT_PAID),0)
From JOB_ACTIVITY_AUDIT,CLAIM55,GROUP_DATA
              WHERE CLAIM55.GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date
					AND JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle
					AND CLAIM55.YEAR_MONTH = cast(cast(year(@Cycle_End_Date) as varchar(4)) + 
						case when len(cast(month(@Cycle_End_Date) as varchar(2))) &lt; 2 Then '0' + cast(month(@Cycle_End_Date) as varchar(2)) 
						else cast(month(@Cycle_End_Date) as varchar(2)) end as int)
						--AND GROUP_DATA.SYSTEM_NUMBER IN(@SYSTEM_NUMBER)
) as TotalAmtPaid

From JOB_ACTIVITY_AUDIT,CLAIM55,GROUP_DATA
              WHERE CLAIM55.GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date
					AND JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle
					AND CLAIM55.YEAR_MONTH = cast(cast(year(@Cycle_End_Date) as varchar(4)) + 
						case when len(cast(month(@Cycle_End_Date) as varchar(2))) &lt; 2 Then '0' + cast(month(@Cycle_End_Date) as varchar(2)) 
						else cast(month(@Cycle_End_Date) as varchar(2)) end as int)
						--AND GROUP_DATA.SYSTEM_NUMBER IN(@SYSTEM_NUMBER)
  
GROUP BY
      GROUP_DATA.SYSTEM_NUMBER,
	Group_Data.SPONSOR_NUMBER,
	Group_Data.MASTER_GROUP,
	Group_Data.GROUP_NUMBER,
      Claim55.YEAR_MONTH,
      JOB_ACTIVITY_AUDIT.WarehouseName
) AS A

LEFT OUTER JOIN

(
SELECT 
GROUP_DATA.SYSTEM_NUMBER,
Group_Data.SPONSOR_NUMBER,
Group_Data.MASTER_GROUP,
Group_Data.GROUP_NUMBER,
ISNULL(Count(CLAIMS.CLAIM_KEY),0) as ClaimsClaimCount,  
ISNULL(SUM(CLAIMS.AMOUNT_PAID),0) as ClaimsAmountPaid,


(
select ISNULL(Count(Claims.CLAIM_KEY),0)
From JOB_ACTIVITY_AUDIT,Claims,GROUP_DATA
       
WHERE (Claims .GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER)
AND ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(@Cycle_End_Date) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(@Cycle_End_Date)) OR ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(DATEADD("MM",-1,@Cycle_End_Date)) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(DATEADD("MM",-1,@Cycle_End_Date)))))
and (RX_DATE &gt;= cast(cast(month(@Cycle_End_Date) as varchar(2)) + '/' + '1' + '/' + cast(year(@Cycle_End_Date) as varchar(4)) as datetime))
and (RX_Date &lt; cast(cast(month(DATEADD("MM",1,@Cycle_End_Date)) as varchar(2)) + '/' + '1' + '/' + cast(year(DATEADD("MM",1,@Cycle_End_Date)) as varchar(4)) as datetime))

  
AND (Claims .Reject_Code_1=0)
AND (JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER)
AND (JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date)
AND (JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle)
AND CLAIMS.CURRENT_CLAIM_INDICATOR &lt;&gt;'D'
--AND GROUP_DATA.SYSTEM_NUMBER IN(@SYSTEM_NUMBER)
) as TotalClaimCount,

(
select ISNULL(SUM(CLAIMS.AMOUNT_PAID),0)
From JOB_ACTIVITY_AUDIT,Claims,GROUP_DATA
       
WHERE (Claims .GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER)
AND ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(@Cycle_End_Date) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(@Cycle_End_Date)) OR ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(DATEADD("MM",-1,@Cycle_End_Date)) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(DATEADD("MM",-1,@Cycle_End_Date)))))
and (RX_DATE &gt;= cast(cast(month(@Cycle_End_Date) as varchar(2)) + '/' + '1' + '/' + cast(year(@Cycle_End_Date) as varchar(4)) as datetime))
and (RX_Date &lt; cast(cast(month(DATEADD("MM",1,@Cycle_End_Date)) as varchar(2)) + '/' + '1' + '/' + cast(year(DATEADD("MM",1,@Cycle_End_Date)) as varchar(4)) as datetime))

  
AND (Claims .Reject_Code_1=0)
AND (JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER)
AND (JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date)
AND (JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle)
AND CLAIMS.CURRENT_CLAIM_INDICATOR &lt;&gt;'D'
--AND GROUP_DATA.SYSTEM_NUMBER IN(@SYSTEM_NUMBER)
) as TotalAmtPaid




From JOB_ACTIVITY_AUDIT,CLAIMS,GROUP_DATA


WHERE (Claims .GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER)
AND ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(@Cycle_End_Date) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(@Cycle_End_Date)) OR ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(DATEADD("MM",-1,@Cycle_End_Date)) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(DATEADD("MM",-1,@Cycle_End_Date)))))
and (RX_DATE &gt;= cast(cast(month(@Cycle_End_Date) as varchar(2)) + '/' + '1' + '/' + cast(year(@Cycle_End_Date) as varchar(4)) as datetime))
and (RX_Date &lt; cast(cast(month(DATEADD("MM",1,@Cycle_End_Date)) as varchar(2)) + '/' + '1' + '/' + cast(year(DATEADD("MM",1,@Cycle_End_Date)) as varchar(4)) as datetime))

  
AND (Claims .Reject_Code_1=0)
AND (JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER)
AND (JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date)
AND (JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle)
AND CLAIMS.CURRENT_CLAIM_INDICATOR &lt;&gt;'D'
--AND GROUP_DATA.SYSTEM_NUMBER IN(@SYSTEM_NUMBER)
GROUP BY 
      GROUP_DATA.SYSTEM_NUMBER,
Group_Data.SPONSOR_NUMBER,
Group_Data.MASTER_GROUP,
Group_Data.GROUP_NUMBER
) AS B
      
      
ON A.SYSTEM_NUMBER = B.SYSTEM_NUMBER AND
A.SPONSOR_NUMBER = B.SPONSOR_NUMBER AND
A.MASTER_GROUP = B.MASTER_GROUP AND
A.GROUP_NUMBER = B.GROUP_NUMBER
WHERE ISNULL(A.CLAIM55CLAIMCOUNT,0) - ISNULL(B.CLAIMSCLAIMCOUNT,0) &lt;&gt; 0 OR
	   ISNULL(A.CLAIM55AMOUNTPAID,0) - ISNULL(B.CLAIMSAmOUNTPAID,0) &lt;&gt; 0

      
ORDER by A.SYSTEM_NUMBER, A.SPONSOR_NUMBER, A.MASTER_GROUP, A.GROUP_NUMBER</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Cycle_End_Date">
            <Value>=Parameters!Cycle_End_Date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Cycle">
            <Value>=Parameters!Cycle.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
    </DataSet>
    <DataSet Name="WH12_CLAIM55DATA">
      <Fields>
        <Field Name="SYSTEM_NUMBER">
          <DataField>SYSTEM_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="YEAR_MONTH">
          <DataField>YEAR_MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WAREHOUSENAME">
          <DataField>WAREHOUSENAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CLAIM55CLAIMCOUNT">
          <DataField>CLAIM55CLAIMCOUNT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CLAIM55AMOUNTPAID">
          <DataField>CLAIM55AMOUNTPAID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CLAIMSCLAIMCOUNT">
          <DataField>CLAIMSCLAIMCOUNT</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CLAIMSAMOUNTPAID">
          <DataField>CLAIMSAMOUNTPAID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="COUNTDIFF">
          <DataField>COUNTDIFF</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AMTDIFF">
          <DataField>AMTDIFF</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TOTALCLAIMCOUNT">
          <DataField>TOTALCLAIMCOUNT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TOTALAMTPAID">
          <DataField>TOTALAMTPAID</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>WH12</DataSourceName>
        <CommandText>select A.SYSTEM_NUMBER AS SYSTEM_NUMBER,
	   A.YEAR_MONTH AS YEAR_MONTH,
	   A.WAREHOUSENAME AS WAREHOUSENAME,
	   A.CLAIM55CLAIMCOUNT AS CLAIM55CLAIMCOUNT,
	   A.CLAIM55AMOUNTPAID AS CLAIM55AMOUNTPAID,
	   B.ClaimsClaimCount AS CLAIMSCLAIMCOUNT,
	   B.ClaimsAmountPaid AS CLAIMSAMOUNTPAID,
	   A.CLAIM55CLAIMCOUNT - B.CLAIMSCLAIMCOUNT AS COUNTDIFF,
	   A.CLAIM55AMOUNTPAID - B.CLAIMSAmOUNTPAID AS AMTDIFF,
	   A.TOTALCLAIMCOUNT AS TOTALCLAIMCOUNT,
	   A.TOTALAMTPAID AS TOTALAMTPAID
FROM


(
select 

GROUP_DATA.SYSTEM_NUMBER,
Claim55.YEAR_MONTH,
JOB_ACTIVITY_AUDIT.WarehouseName,
Sum(Claim55.CLAIMS) as Claim55ClaimCount,
Sum(Claim55.AMOUNT_PAID) as Claim55AmountPaid,

(
select Sum(Claim55.CLAIMS)
From JOB_ACTIVITY_AUDIT,CLAIM55,GROUP_DATA
              WHERE CLAIM55.GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date
					AND JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle
					AND CLAIM55.YEAR_MONTH = cast(cast(year(@Cycle_End_Date) as varchar(4)) + 
						case when len(cast(month(@Cycle_End_Date) as varchar(2))) &lt; 2 Then '0' + cast(month(@Cycle_End_Date) as varchar(2)) 
						else cast(month(@Cycle_End_Date) as varchar(2)) end as int)
  ) as TotalClaimCount,

(
select Sum(Claim55.AMOUNT_PAID)
From JOB_ACTIVITY_AUDIT,CLAIM55,GROUP_DATA
              WHERE CLAIM55.GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date
					AND JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle
					AND CLAIM55.YEAR_MONTH = cast(cast(year(@Cycle_End_Date) as varchar(4)) + 
						case when len(cast(month(@Cycle_End_Date) as varchar(2))) &lt; 2 Then '0' + cast(month(@Cycle_End_Date) as varchar(2)) 
						else cast(month(@Cycle_End_Date) as varchar(2)) end as int)
) as TotalAmtPaid

From JOB_ACTIVITY_AUDIT,CLAIM55,GROUP_DATA
              WHERE CLAIM55.GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER
					AND JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date
					AND JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle
					AND CLAIM55.YEAR_MONTH = cast(cast(year(@Cycle_End_Date) as varchar(4)) + 
						case when len(cast(month(@Cycle_End_Date) as varchar(2))) &lt; 2 Then '0' + cast(month(@Cycle_End_Date) as varchar(2)) 
						else cast(month(@Cycle_End_Date) as varchar(2)) end as int)
  
GROUP BY
      Group_Data.System_Number,
      Claim55.YEAR_MONTH,
      JOB_ACTIVITY_AUDIT.WarehouseName
) AS A

LEFT OUTER JOIN

(
SELECT 
GROUP_DATA.SYSTEM_NUMBER,
Count(CLAIMS.CLAIM_KEY) as ClaimsClaimCount,  
SUM(CLAIMS.AMOUNT_PAID) as ClaimsAmountPaid,


(
select Count(Claims.CLAIM_KEY)
From JOB_ACTIVITY_AUDIT,Claims,GROUP_DATA
       
WHERE (Claims .GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER)
AND ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(@Cycle_End_Date) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(@Cycle_End_Date)) OR ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(DATEADD("MM",-1,@Cycle_End_Date)) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(DATEADD("MM",-1,@Cycle_End_Date)))))
and (RX_DATE &gt;= cast(cast(month(@Cycle_End_Date) as varchar(2)) + '/' + '1' + '/' + cast(year(@Cycle_End_Date) as varchar(4)) as datetime))
and (RX_Date &lt; cast(cast(month(DATEADD("MM",1,@Cycle_End_Date)) as varchar(2)) + '/' + '1' + '/' + cast(year(DATEADD("MM",1,@Cycle_End_Date)) as varchar(4)) as datetime))
  
AND (Claims .Reject_Code_1=0)
AND (JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER)
AND (JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date)
AND (JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle)
AND CLAIMS.CURRENT_CLAIM_INDICATOR &lt;&gt;'D'
) as TotalClaimCount,

(
select SUM(CLAIMS.AMOUNT_PAID)
From JOB_ACTIVITY_AUDIT,Claims,GROUP_DATA
       
WHERE (Claims .GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER)
AND ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(@Cycle_End_Date) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(@Cycle_End_Date)) OR ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(DATEADD("MM",-1,@Cycle_End_Date)) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(DATEADD("MM",-1,@Cycle_End_Date)))))
and (RX_DATE &gt;= cast(cast(month(@Cycle_End_Date) as varchar(2)) + '/' + '1' + '/' + cast(year(@Cycle_End_Date) as varchar(4)) as datetime))
and (RX_Date &lt; cast(cast(month(DATEADD("MM",1,@Cycle_End_Date)) as varchar(2)) + '/' + '1' + '/' + cast(year(DATEADD("MM",1,@Cycle_End_Date)) as varchar(4)) as datetime))

  
AND (Claims .Reject_Code_1=0)
AND (JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER)
AND (JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date)
AND (JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle)
AND CLAIMS.CURRENT_CLAIM_INDICATOR &lt;&gt;'D'
) as TotalAmtPaid




From JOB_ACTIVITY_AUDIT,CLAIMS,GROUP_DATA


WHERE (Claims .GROUP_NUMBER = GROUP_DATA.GROUP_NUMBER)
AND ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(@Cycle_End_Date) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(@Cycle_End_Date)) OR ((YEAR(CLAIMS.PERIOD_ENDING) = YEAR(DATEADD("MM",-1,@Cycle_End_Date)) AND MONTH(CLAIMS.PERIOD_ENDING) = MONTH(DATEADD("MM",-1,@Cycle_End_Date)))))
and (RX_DATE &gt;= cast(cast(month(@Cycle_End_Date) as varchar(2)) + '/' + '1' + '/' + cast(year(@Cycle_End_Date) as varchar(4)) as datetime))
and (RX_Date &lt; cast(cast(month(DATEADD("MM",1,@Cycle_End_Date)) as varchar(2)) + '/' + '1' + '/' + cast(year(DATEADD("MM",1,@Cycle_End_Date)) as varchar(4)) as datetime))

  
AND (Claims .Reject_Code_1=0)
AND (JOB_ACTIVITY_AUDIT.TransactionSystemNumber = GROUP_DATA.SYSTEM_NUMBER)
AND (JOB_ACTIVITY_AUDIT.TransactionPeriodEnding = @Cycle_End_Date)
AND (JOB_ACTIVITY_AUDIT.TransactionInputFileName like '\\FILE20\' + @Cycle)
AND CLAIMS.CURRENT_CLAIM_INDICATOR &lt;&gt;'D'
GROUP BY 
      GROUP_DATA.SYSTEM_NUMBER
) AS B
      
      
ON A.SYSTEM_NUMBER = B.SYSTEM_NUMBER


      
ORDER by A.SYSTEM_NUMBER</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Cycle_End_Date">
            <Value>=Parameters!Cycle_End_Date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Cycle">
            <Value>=Parameters!Cycle.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
