Parameters!MasterGroupNumber.value(0) = "-1", Mid(Parameters!SponsorNumber.Label(0),6) ,
Parameters!GroupNumber.Value(0) = "-1", Mid(Parameters!MasterGroupNumber.Label(0),11) 
)

''Parameters!SponsorNumber.Value(0) &amp; " - " &amp; rtrim(Parameters!SponsorNumber.Value(0))</Value>
