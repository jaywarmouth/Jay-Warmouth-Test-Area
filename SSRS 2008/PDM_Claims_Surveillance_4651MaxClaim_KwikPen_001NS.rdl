        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember>
              <KeepWithGroup>After</KeepWithGroup>
              <KeepTogether>true</KeepTogether>
            </TablixMember>
            <TablixMember>
              <Group Name="WACPLUS_3">
                <Filters>
                  <Filter>
                    <FilterExpression>=Fields!CCI.Value</FilterExpression>
                    <Operator>In</Operator>
                    <FilterValues>
                      <FilterValue>Y</FilterValue>
                      <FilterValue>C</FilterValue>
                    </FilterValues>
                  </Filter>
                  <Filter>
                    <FilterExpression>=IIF(
    CInt(Fields!GROUP_NUMBER.Value) &gt;= 74670014 AND
    CInt(Fields!GROUP_NUMBER.Value) &lt;= 74670017 AND
    
(Fields!NDC.Value = "2356611") OR
 (Fields!NDC.Value = "2355511") OR
(Fields!NDC.Value = "2354411") OR
(Fields!NDC.Value = "2353311") OR
(Fields!NDC.Value = "2352211") OR
(Fields!NDC.Value = "2356611") OR
(Fields!NDC.Value = "2351111") ,
    1,
    0
)</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                      <FilterValue DataType="Integer">1</FilterValue>
                    </FilterValues>
                  </Filter>
                  <Filter>
                    <FilterExpression>=Fields!AMOUNT_PAID.Value</FilterExpression>
                    <Operator>GreaterThan</Operator>
                    <FilterValues>
                      <FilterValue>=CDec(Fields!WACRefPrice.Value) * CDec(1.03)</FilterValue>
                    </FilterValues>
                  </Filter>
                </Filters>
                <DataElementName>Detail</DataElementName>
              </Group>
              <TablixMembers>
                <TablixMember />
              </TablixMembers>
              <DataElementName>Detail_Collection</DataElementName>
              <DataElementOutput>Output</DataElementOutput>
              <KeepTogether>true</KeepTogether>
            </TablixMember>
          </TablixMembers>
