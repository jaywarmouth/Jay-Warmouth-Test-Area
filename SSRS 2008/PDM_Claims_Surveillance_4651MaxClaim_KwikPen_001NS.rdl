                <Filters>
                  <Filter>
                    <FilterExpression>=Fields!REJECT_CODE_1.Value</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                      <FilterValue DataType="Integer">2274</FilterValue>
                    </FilterValues>
                  </Filter>
                  <Filter>
                    <FilterExpression>=IIF(
    CInt(Fields!GROUP_NUMBER.Value) &gt;= 74670014 AND
    CInt(Fields!GROUP_NUMBER.Value) &lt;= 74670017 AND
    

    (Fields!NDC.Value = "2356611" AND Fields!COPAY.Value - Fields!TAX.Value &lt;&gt; 299) OR
    (Fields!NDC.Value = "2355511" AND Fields!COPAY.Value - Fields!TAX.Value &lt;&gt; 399) OR
    (Fields!NDC.Value = "2354411" AND Fields!COPAY.Value - Fields!TAX.Value &lt;&gt; 449) OR
    (Fields!NDC.Value = "2353311" AND Fields!COPAY.Value - Fields!TAX.Value &lt;&gt; 699) OR
    (Fields!NDC.Value = "2352211" AND Fields!COPAY.Value - Fields!TAX.Value &lt;&gt; 699) OR
    (Fields!NDC.Value = "2351111" AND Fields!COPAY.Value - Fields!TAX.Value &lt;&gt; 699),
    1,
    0
)</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                      <FilterValue DataType="Integer">1</FilterValue>
                    </FilterValues>
                  </Filter>
                  <Filter>
                    <FilterExpression>=Fields!COPAY.Value</FilterExpression>
                    <Operator>NotEqual</Operator>
                    <FilterValues>
                      <FilterValue>= Fields!AWP_100_PERCENT.Value + Fields!DISP_FEE.Value</FilterValue>
                    </FilterValues>
                  </Filter>
