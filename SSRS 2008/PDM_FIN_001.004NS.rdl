        / IIF(Sum(Fields!Paper_Claims.Value) = 0, 1, Sum(Fields!Paper_Claims.Value))))
  + (Sum(Fields!Electronic_Claims.Value) 
     * (Sum(Fields!Electronic_Claims.Value * Fields!Switch_Fee.Value) 
        / IIF(Sum(Fields!Electronic_Claims.Value) = 0, 1, Sum(Fields!Electronic_Claims.Value))))
, 2)</Value>
