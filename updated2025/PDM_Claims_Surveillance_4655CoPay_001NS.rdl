            <TablixMember>
              <Group Name="OCC8_NDC2">
                <Filters>
                  <Filter>
                    <FilterExpression>=Fields!OTHER_COVERAGE_CODE.Value</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                      <FilterValue DataType="Integer">8</FilterValue>
                    </FilterValues>
                  </Filter>
                  <Filter>
                    <FilterExpression>=IIF(Fields!NDC.Value = 81520025514 OR Fields!NDC.Value = 81520025014, 1, 0)</FilterExpression>
